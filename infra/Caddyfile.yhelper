# yHelper-only virtual host example.
# The live public ingress is owned by the shared edge stack.
# Keep this file only as a yHelper-specific routing snippet reference.

yhelper.app {
    encode zstd gzip

    @api path /api/*
    handle @api {
        reverse_proxy 127.0.0.1:8000
    }

    handle {
        reverse_proxy 127.0.0.1:3010
    }
}

yhelper.seul.one, www.yhelper.app {
    respond "Not found" 404
}
